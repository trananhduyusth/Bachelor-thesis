+    // Wind velocity in the autopilot's frame.
+    //
+    // ArduPilot's JSON SITL backend has no wind model of its own: SIM_WIND_*
+    // is inert and, unless the simulator reports wind, it computes airspeed
+    // from ground speed. Gazebo's LiftDrag already uses this same wind entity
+    // for the aerodynamics, so reporting it here is what makes the autopilot's
+    // airspeed agree with the air the wings are actually flying in.
+    gz::math::Vector3d windWldA = gz::math::Vector3d::Zero;
+    {
+      const gz::sim::Entity windEntity =
+          _ecm.EntityByComponents(gz::sim::components::Wind());
+      if (windEntity != gz::sim::kNullEntity)
+      {
+        const auto *windLinearVel =
+            _ecm.Component<gz::sim::components::WorldLinearVelocity>(windEntity);
+        if (windLinearVel != nullptr)
+        {
+          windWldA = wldAToWldG.Rot() * windLinearVel->Data();
+        }
+      }
+    }
